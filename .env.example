# Bu dosyayı ".env" adıyla kopyala. .env GitHub'a gönderilmez (gizli anahtarlar burada durur).
# Fiyat toplayıcının ürettiği dosyanın internet adresi:
EXPO_PUBLIC_FIYAT_URL=https://raw.githubusercontent.com/FatihACI/diy-hobi/main/fiyat-toplayici/cikti/fiyatlar.json
# YouTube video arama aracı için (npm run video:bul). Kendi anahtarını yaz:
YOUTUBE_API_KEY=
